<?xml version="1.0" encoding="utf-8"?>
<!-- One event row, font "serif". RemoteViews cannot change a typeface, so each font has its own layout.
     Columns: colour dot | day | time | title | location (gets what is left, may be hidden). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="0.5dp"
    android:paddingBottom="0.5dp">

    <ImageView
        android:id="@+id/dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="3dp"
        android:importantForAccessibility="no"
        android:src="@drawable/dot" />

    <TextView
        android:fallbackLineSpacing="false"
        android:includeFontPadding="false"
        android:id="@+id/date"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="1"
        android:textColor="@color/w_text2"
        android:textSize="14sp"
        tools:text="Morg." />

    <TextView
        android:fallbackLineSpacing="false"
        android:includeFontPadding="false"
        android:id="@+id/time"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:maxLines="1"
        android:textColor="@color/w_text2"
        android:textSize="14sp"
        tools:text="16:00" />

    <TextView
        android:fallbackLineSpacing="false"
        android:includeFontPadding="false"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="1"
        android:textColor="@color/w_text"
        android:textSize="14sp"
        tools:text="Zahnarzt" />

    <TextView
        android:fallbackLineSpacing="false"
        android:includeFontPadding="false"
        android:id="@+id/location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="1"
        android:textColor="@color/w_text2"
        android:textSize="14sp"
        tools:text="Raum 2" />
</LinearLayout>
