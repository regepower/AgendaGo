<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview shown in the launcher's widget picker (Android 12+). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="1dp">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot"
            android:tint="#43A047" />

        <TextView
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/preview_date_1"
            android:textColor="@color/w_text2"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/preview_title_1"
            android:textColor="@color/w_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="1dp">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot"
            android:tint="#1E88E5" />

        <TextView
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/preview_date_2"
            android:textColor="@color/w_text2"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/preview_title_2"
            android:textColor="@color/w_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="1dp">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot"
            android:tint="#E53935" />

        <TextView
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/preview_date_3"
            android:textColor="@color/w_text2"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/preview_title_3"
            android:textColor="@color/w_text"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
